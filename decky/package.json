{
  "name": "turbinehub-decky",
  "private": true,
  "description": "Turbine Hub in Steam's Quick Access menu: battery, temperatures, this game's switches, Game Boost and lighting at a glance.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/words.test.ts && python3 -m unittest discover -s tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ravenor907/TurbineHub.git"
  },
  "keywords": ["decky", "plugin", "steamos"],
  "author": "Ravenor907",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
